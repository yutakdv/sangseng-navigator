# ============================================================
# 상생 나침반 환경변수
# 사용법:  cp .env.example .env  →  아래 안내대로 값 채우기
# .env는 절대 커밋하지 않는다 (.gitignore에 포함됨)
# ★ = 유탁이 직접 발급/입력. 각 키의 상세 발급 절차는 docs/plan/04-env-and-data.md
# 주의: 이 파일은 deploy-backend.sh가 `source`로 읽는다 — 값에 공백·특수문자
#       (공공데이터 Decoding 키의 +, /, = 등)가 있으면 반드시 "따옴표"로 감싼다
#       예) DATA_GO_KR_API_KEY="abc+def/ghi=="
# ============================================================

# ------------------------------------------------------------
# 1) 공공데이터포털 인증키  ★
# ------------------------------------------------------------
# 발급 위치: https://www.data.go.kr → 로그인 → [마이페이지] → [오픈API]
#            → [인증키 발급현황] → "일반 인증키 (Decoding)" 값을 복사
# 주의: Encoding 키가 아니라 **Decoding 키**를 붙여넣는다
#       (requests가 URL 인코딩을 자동으로 하므로 Decoding 키가 맞음)
# 이 키 하나로 아래 3개 API를 모두 호출한다. 단, 각 API마다 "활용신청" 승인이 필요:
#   ① data.go.kr 검색창에 "강원랜드 하이원포인트 가맹점 상세정보" 검색
#      → 오픈API 탭 → 상세 페이지 → [활용신청] 버튼 → 승인 대기
#   ② "강원랜드 일자별 카지노 입장객" 검색 → 동일하게 활용신청
#   ③ "소상공인시장진흥공단 상가(상권)정보" 검색 → 동일하게 활용신청
# 승인 후: 마이페이지 → 오픈API → [활용신청 현황] → 각 API 상세에서
#          엔드포인트 URL·요청 파라미터 명세 확인 (pipeline 스크립트 주석에 기록)
DATA_GO_KR_API_KEY=

# ------------------------------------------------------------
# 2) 지오코딩 (가맹점 주소 → 좌표, 파이프라인 로컬 전용)  ★
# ------------------------------------------------------------
# 기본: Kakao REST API 키 (도메인 등록 불필요 — JS/모빌리티 키와 다름)
# 발급 위치: https://developers.kakao.com → 로그인 → [내 애플리케이션]
#            → [애플리케이션 추가하기] (이름: sangseng-navigator, 회사명 아무거나)
#            → 생성된 앱 클릭 → [앱 설정] > [앱 키] → "REST API 키" 값을 복사
KAKAO_REST_API_KEY=

# 폴백: VWorld 지오코더 (Kakao 발급이 막힐 때만)
# 발급 위치: https://www.vworld.kr → 회원가입 → 상단 [오픈API] → [인증키 발급]
#            → 활용 URL은 http://localhost 입력 가능 → 발급된 인증키 복사
VWORLD_API_KEY=

# ------------------------------------------------------------
# 3) LLM (Action Card 생성·시뮬레이션 설명·위젯 문구)  ★
# ------------------------------------------------------------
# OpenAI 키 발급: https://platform.openai.com → 로그인
#   → 우상단 프로필 → [API keys] (직행: platform.openai.com/api-keys)
#   → [Create new secret key] → 생성 직후 한 번만 보이는 sk-... 값을 복사
#   → 주의: [Settings] > [Billing]에서 결제수단 등록 + 최소 $5 크레딧 필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# 4) AWS / 백엔드  ★ (키는 .env가 아니라 `aws configure`로 설정)
# ------------------------------------------------------------
# AWS 액세스 키 발급: https://console.aws.amazon.com → IAM → [사용자]
#   → 본인 사용자 선택 → [보안 자격 증명] 탭 → [액세스 키 만들기]
#   → 용도 "Command Line Interface(CLI)" 선택 → Access key ID / Secret 복사
#   → 터미널에서 `aws configure` 실행해 입력 (리전: ap-northeast-2)
#   → 확인: `aws sts get-caller-identity` 가 계정 정보를 출력하면 성공
AWS_REGION=ap-northeast-2

# DynamoDB 테이블명: infra/deploy-backend.sh 1차 배포 후 터미널에 출력되는
# CloudFormation Outputs의 "CardsTable" 값을 그대로 붙여넣는다
# (예: sangseng-backend-CardsTable-1A2B3C4D5E) — 로컬 BE도 이 실제 테이블을 사용
# 배포 전이라 비워 두어도 된다 — 빈 값이면 코드가 `sangseng-cards` 로 폴백한다 (backend/app/db.py)
CARDS_TABLE=

# 추진 상태의 날짜별 메모·실측 지표를 보관하는 별도 DynamoDB 테이블.
# 배포 후 CloudFormation Outputs의 "ProgressRecordsTable" 값을 사용한다.
# 비우면 로컬 기본값 `sangseng-progress-records`를 사용한다.
PROGRESS_RECORDS_TABLE=

# 앱(FastAPI) CORS 허용 오리진, 콤마 구분. 배포에서는 반드시 실제 프론트 오리진을 명시한다.
# `*`는 안전상 거부되며, 비우면 로컬 개발 주소만 허용된다.
# 예) ALLOWED_ORIGINS=https://sangseng-navigator.vercel.app,http://localhost:3100
# deploy-backend.sh가 SAM 파라미터 AllowedOrigins로 넘긴다 (09 문서 §5 — 게이트웨이 CORS와 2층 구조)
ALLOWED_ORIGINS=

# 공개 데모 상태 변경 잠금. true면 카드 생성·결정·적격성·추진 상태 mutation이 403으로 차단된다.
# 인증/권한이 연결되지 않은 공개 배포는 true를 유지한다.
DEMO_READ_ONLY=false

# 변경 API 서버 간 인증 토큰. DEMO_READ_ONLY=false인 환경에서는 필수다.
# 충분히 긴 무작위 값을 생성해 백엔드 MUTATION_API_TOKEN과 프론트 서버 API_MUTATION_TOKEN에
# 같은 값으로 넣는다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되므로 절대 사용하지 않는다.
MUTATION_API_TOKEN=

# Lambda 동시 실행 상한. 비우면 template Default 5 (무인증 공개 URL의 LLM 호출 남용 방어, 09 §5.5)
# 계정 미예약 동시성 여유 부족으로 배포가 실패하면 -1 을 넣어 설정 자체를 생략한다
RESERVED_CONCURRENCY=

# ------------------------------------------------------------
# 5) 프론트엔드 (frontend/.env.local 에 두는 값 — 여기는 참고용)
# ------------------------------------------------------------
# NEXT_PUBLIC_API_BASE:  ★ 필수 — 비우면 FE 빌드가 실패한다 (mock 폴백 제거)
#   - 로컬 BE 연동: http://localhost:8000
#   - 배포: Vercel 대시보드 → 프로젝트 → [Settings] > [Environment Variables]에
#     이름 NEXT_PUBLIC_API_BASE, 값 = service 스택 Outputs의 ApiUrl
#     (예: https://xxxx.execute-api.ap-northeast-2.amazonaws.com — 끝 슬래시 없이) 등록 후 Redeploy
NEXT_PUBLIC_API_BASE=

# Next.js 서버가 변경 API와 담당자용 추진 이력 조회를 호출할 때 사용하는 서버 전용 토큰.
# 위 MUTATION_API_TOKEN과 **같은 값**을 넣는다. 브라우저에는 노출되지 않는다.
# FE는 API_MUTATION_TOKEN을 먼저 보고 없으면 MUTATION_API_TOKEN을 쓴다 —
# Vercel에는 둘 중 아무 이름으로 넣어도 된다(이름을 바꿔 넣어 401이 나던 함정 제거).
API_MUTATION_TOKEN=

# 프론트의 변경 UI와 Server Action을 잠근다. 공개 데모는 true.
NEXT_PUBLIC_DEMO_READ_ONLY=false

# 방문객 위젯 지도 — Kakao Developers의 JavaScript 키
# 앱 설정 > 플랫폼 > Web에 http://localhost:3100 (및 배포 도메인)을 등록한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ------------------------------------------------------------
# 카드 상세(/cards/[id])의 500m 반경 지도는 MapLibre GL + OpenFreeMap 이고,
# 방문객 위젯(/widget)은 위 Kakao Maps JS 키를 우선 사용하며 키 문제 시 지도형 fallback을 보인다.
# 카드 상세 지도는 API 키·도메인 등록·가입이 전부 불필요 (docs/plan/02 "지도 결정" 참조)
# 홈의 지역 진단은 외부 지도 SDK 없이 RegionTileMap 개념도를 사용한다.
# ------------------------------------------------------------

# ------------------------------------------------------------
# 담당자 표시명 (선택) — 허브 인사말·사이드바 계정 칸에 쓴다
# ------------------------------------------------------------
# 인증 연동 전까지의 임시 값. 비워 두면 데모 시드("지역상생팀 홍길동")를 써서
# "홍길동 담당자님"으로 인사하고, 시드까지 비면 "담당자님"으로 폴백한다.
# 표시용 이름이라 민감 정보가 아니다.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_TEAM=
